<IfModule mod_rewrite.c>
# That was ONLY to protect you from 500 errors
# if your server did not have mod_rewrite enabled

RewriteEngine On
# RewriteBase /
# NOT needed unless you're using mod_alias to redirect

# Canonical production host: force HTTPS and strip www without looping behind a proxy.
RewriteCond %{HTTP_HOST} ^www\.linkprofilde\.com$ [NC]
RewriteRule ^ https://linkprofilde.com%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^linkprofilde\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://linkprofilde.com%{REQUEST_URI} [R=301,L]

RewriteCond %{REQUEST_URI} !/public
RewriteRule ^(.*)$ public/$1 [L]
# Direct all requests to /public folder

</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# This domain inherits the “PHP” package.
# php -- END cPanel-generated handler, do not edit
