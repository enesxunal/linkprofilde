{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ezyang/htmlpurifier": "^4.19.1",
        "guzzlehttp/guzzle": "^7.15.2",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image": "^2.7",
        "laravel/framework": "^12.61.1",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "mollie/laravel-mollie": "^4.1",
        "razorpay/razorpay": "2.*",
        "shetabit/visitor": "^4.5.6",
        "spatie/laravel-permission": "^6.25",
        "srmklive/paypal": "^3.1.1",
        "stevebauman/location": "^7.6.3",
        "stripe/stripe-php": "^10.18",
        "tightenco/ziggy": "^2.6.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/breeze": "^2.4.2",
        "laravel/pint": "^1.30.4",
        "laravel/sail": "^1.67",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^11.5.56",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "classmap": [
            "app/Helpers"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
